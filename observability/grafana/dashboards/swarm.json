{
  "uid": "swarm",
  "title": "Swarm",
  "description": "Search-and-converge swarm simulator: radio channel health, how fast news of the target spreads, and per-sighting propagation traces.",
  "tags": [
    "swarm",
    "mavlink"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Drones informed",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "swarm_agents_informed",
          "legendFormat": "informed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Targets covered",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "swarm_targets_covered",
          "legendFormat": "covered"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Targets with at least one drone within 4 m, out of all targets in the field."
    },
    {
      "type": "stat",
      "title": "Packet loss (1m)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(swarm_netem_lost_total[1m])) / (sum(rate(swarm_netem_lost_total[1m])) + sum(rate(swarm_netem_delivered_total[1m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Missed brain reports (1m)",
      "description": "Ticks on which a drone's brain didn't answer the world in time. Non-zero means drones are falling behind.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(swarm_world_missed_reports_total[1m])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "timeseries",
      "title": "Drones that know about a target",
      "description": "'cut off' = drones that currently hear no other drone; they fly back toward the swarm to regain contact.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "swarm_agents_informed",
          "legendFormat": "informed"
        },
        {
          "refId": "B",
          "expr": "swarm_agents",
          "legendFormat": "total"
        },
        {
          "refId": "C",
          "expr": "swarm_agents_isolated",
          "legendFormat": "cut off"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Distance from each target to its nearest drone",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "swarm_target_nearest_agent_distance_meters",
          "legendFormat": "target {{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: m",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Radio frames sent per second, by MAVLink message",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (msg) (rate(swarm_netem_frames_in_total[1m]))",
          "legendFormat": "{{msg}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Radio deliveries per second",
      "description": "For every frame, each other drone is either delivered to, lost to random packet loss, or out of radio range.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(swarm_netem_delivered_total[1m]))",
          "legendFormat": "delivered"
        },
        {
          "refId": "B",
          "expr": "sum(rate(swarm_netem_lost_total[1m]))",
          "legendFormat": "lost"
        },
        {
          "refId": "C",
          "expr": "sum(rate(swarm_netem_out_of_range_total[1m]))",
          "legendFormat": "out of range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Radio latency per delivery",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(swarm_netem_delivery_delay_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(swarm_netem_delivery_delay_seconds_bucket[1m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Age of a sighting when a drone first hears about it",
      "description": "How stale the news already is by the time it reaches a drone that didn't see the target itself. Grows with hop count and packet loss.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(swarm_agent_relayed_sighting_age_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(swarm_agent_relayed_sighting_age_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Sighting propagation traces (click a trace ID)",
      "description": "One trace per target sighting: the drone that spotted it, then every drone that heard about it, each parented to whoever relayed it.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"swarm-sim\" && name=\"target_spotted\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "type": "row",
      "title": "Failures",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Drones alive",
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "swarm_agents_alive"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Failure detection time (avg)",
      "description": "Time from a drone's death until a neighbor declared it lost, averaged over all detections. Bounded by the heartbeat timeout minus however long ago the dead drone's last heartbeat went out.",
      "gridPos": {
        "x": 6,
        "y": 39,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(swarm_failure_detection_latency_seconds_sum) / sum(swarm_failure_detection_latency_seconds_count)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "False alarms (total)",
      "description": "A live drone in radio range declared lost because its heartbeats happened to be dropped. Lower the heartbeat timeout and this rises.",
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(swarm_agent_neighbor_lost_total{verdict=\"false_alarm\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Drones killed (total)",
      "gridPos": {
        "x": 18,
        "y": 39,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(swarm_drones_failed_total) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "timeseries",
      "title": "Neighbors declared lost, by what actually happened",
      "description": "dead = the neighbor really failed; out_of_range = alive but beyond radio range (a correct loss of link); false_alarm = alive and in range, heartbeats were just lost. left = it was taken out of the mission on purpose.",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (verdict) (increase(swarm_agent_neighbor_lost_total[1m]))",
          "legendFormat": "{{verdict}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Failure traces (click a trace ID)",
      "description": "One trace per killed drone: drone_failed, then a failure_detected span from every neighbor that noticed, with its detection latency.",
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"swarm-sim\" && name=\"drone_failed\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "type": "row",
      "title": "Consensus",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Liars active",
      "description": "Drones whose radio is broadcasting a fake target.",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "swarm_liars"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Liars caught (total)",
      "description": "Times a drone flew to a reported spot, saw nothing there, and stopped trusting the liar that reported it.",
      "gridPos": {
        "x": 8,
        "y": 52,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(swarm_agent_sighting_refuted_total{verdict=\"liar_caught\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Honest drones distrusted (total)",
      "description": "Refutations of an honest drone's report: the target moved away between the sighting and the check. Should stay near 0.",
      "gridPos": {
        "x": 16,
        "y": 52,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(swarm_agent_sighting_refuted_total{verdict=\"honest_distrusted\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "timeseries",
      "title": "Drones by mode",
      "description": "searching = no usable news; investigating = flying to check an unconfirmed report; converging = target confirmed by quorum or seen firsthand.",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (swarm_agents_mode)",
          "legendFormat": "{{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 40
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Reports refuted, by verdict",
      "description": "liar_caught = the observer really was lying; honest_distrusted = a real report that went stale before anyone checked it.",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (verdict) (increase(swarm_agent_sighting_refuted_total[1m]))",
          "legendFormat": "{{verdict}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Flight physics",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 65,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Collisions (total)",
      "description": "Times two drones' airframes physically touched. Collision avoidance in the brain has to work against real inertia: an airframe can't stop or turn instantly.",
      "gridPos": {
        "x": 0,
        "y": 66,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(swarm_collisions_total) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Wind",
      "description": "Wind speed over the field, set from the viewer's Weather panel.",
      "gridPos": {
        "x": 8,
        "y": 66,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "swarm_wind_speed_meters_per_second"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocityms",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Max tilt",
      "description": "The most any drone's rotor disk is tilted from level right now: hard maneuvering, or leaning into wind.",
      "gridPos": {
        "x": 16,
        "y": 66,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(swarm_drone_tilt_deg)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "degree",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "timeseries",
      "title": "Collisions per minute",
      "description": "Bursts tend to come when many drones rush toward a fresh sighting at once.",
      "gridPos": {
        "x": 0,
        "y": 70,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(swarm_collisions_total[1m])) or vector(0)",
          "legendFormat": "collisions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Tilt per drone",
      "description": "Each autopilot leans its airframe to accelerate and to hold position against wind.",
      "gridPos": {
        "x": 12,
        "y": 70,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "swarm_drone_tilt_deg",
          "legendFormat": "drone {{drone_sysid}}"
        }
      ],
